{
  "name": "good_fit",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
  "build": "tsc",
  "start": "node dist/server.js",
  "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node' src/server.ts",
  "lint": "eslint 'src/**/*.ts'",
  "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,scss,md}'",
  "test": "vitest run",
  "test:watch": "vitest",
  "migrate": "ts-node src/db/migrate.ts up",
  "migrate:down": "ts-node src/db/migrate.ts down",
  "migrate:pending": "ts-node src/db/migrate.ts pending"
},
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.7.2",
    "mysql2": "^3.17.4",
    "typescript-eslint": "^8.49.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.0.0",
    "@types/supertest": "^7.2.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "express": "^5.2.1",
    "install": "^0.13.0",
    "nodemon": "^3.1.11",
    "npm": "^11.7.0",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "umzug": "^3.8.3",
    "vitest": "^4.1.7"
  }
}
